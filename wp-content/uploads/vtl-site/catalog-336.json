{"items": [{"html": "<a class=\"v-card\" href=\"/san-pham/san-pham-iot/dong-ho-do-luu-luong-vortex-thong-minh/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/fdmljd3r/s_svf128_1.jpg?width=600&amp;v=1dd5fbbca61593d\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n        <h3 class=\"v-card__title\">&#x110;&#x1ED3;ng h&#x1ED3; &#x111;o l&#x1B0;u l&#x1B0;&#x1EE3;ng Vortex th&#xF4;ng minh</h3>\n <p class=\"v-card__text\">&#x110;&#x1ED3;ng h&#x1ED3; vortex th&#xF4;ng minh SVF128 &#x111;o l&#x1B0;u l&#x1B0;&#x1EE3;ng h&#x1A1;i, kh&#xED;, ch&#x1EA5;t l&#x1ECF;ng theo nguy&#xEA;n l&#xFD; K&#xE1;rm&#xE1;n, t&#xED;ch h&#x1EE3;p &#xE1;p su&#x1EA5;t &#x2013; nhi&#x1EC7;t &#x111;&#x1ED9;, k&#x1EBF;t n&#x1ED1;i IoT kh&#xF4;ng d&#xE2;y.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["iot-giam-sat-nang-luong"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/san-pham-iot/he-thong-giam-sat-dien-nang/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/h41fi4di/giam-sat-dien-nang-h1-1024x512.png?width=600&amp;v=1dd5fbbca5beaff\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n        <h3 class=\"v-card__title\">H&#x1EC7; th&#x1ED1;ng gi&#xE1;m s&#xE1;t &#x111;i&#x1EC7;n n&#x103;ng</h3>\n <p class=\"v-card__text\">H&#x1EC7; th&#x1ED1;ng gi&#xE1;m s&#xE1;t &#x111;i&#x1EC7;n n&#x103;ng tr&#xEA;n n&#x1EC1;n t&#x1EA3;ng IoT Globiots: thu th&#x1EAD;p t&#x1EF1; &#x111;&#x1ED9;ng s&#x1ED1; li&#x1EC7;u &#x111;i&#x1EC7;n, n&#x1B0;&#x1EDB;c, h&#x1A1;i, kh&#xED; n&#xE9;n; dashboard, c&#x1EA3;nh b&#xE1;o, b&#xE1;o c&#xE1;o tr&#xEA;n m&#x1ECD;i thi&#x1EBF;t b&#x1ECB;.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["iot-giam-sat-nang-luong"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/san-pham-iot/giam-sat-chat-luong-khong-khi-trong-nha-iaq/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/j0kfcwmc/iaq.jpg?width=600&amp;v=1dd5fbbca89090c\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n        <h3 class=\"v-card__title\">Gi&#xE1;m s&#xE1;t ch&#x1EA5;t l&#x1B0;&#x1EE3;ng kh&#xF4;ng kh&#xED; trong nh&#xE0; (IAQ)</h3>\n <p class=\"v-card__text\">Gi&#xE1;m s&#xE1;t ch&#x1EA5;t l&#x1B0;&#x1EE3;ng kh&#xF4;ng kh&#xED; trong nh&#xE0; (IAQ): PM2.5, PM10, nhi&#x1EC7;t &#x111;&#x1ED9;, &#x111;&#x1ED9; &#x1EA9;m, CO2, TVOC; m&#xE0;n h&#xEC;nh c&#x1EA3;m &#x1EE9;ng, k&#x1EBF;t n&#x1ED1;i WiFi, Ethernet, NB-IoT, LoRaWAN.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["iot-giam-sat-nang-luong"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/san-pham-iot/bo-dieu-khien-iot-edge-weidmuller-u-control/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/ailfrmdd/ucontrol-1.webp?width=600&amp;v=1dd5fc16c04c6ba\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Weidm&#xFC;ller</span>         <h3 class=\"v-card__title\">B&#x1ED9; &#x111;i&#x1EC1;u khi&#x1EC3;n &amp; IoT Edge Weidm&#xFC;ller u-control M3000/M4000</h3>\n <p class=\"v-card__text\">B&#x1ED9; &#x111;i&#x1EC1;u khi&#x1EC3;n t&#x1EF1; &#x111;&#x1ED9;ng h&#xF3;a v&#xE0; EDGE ch&#x1EA1;y u-OS, l&#x1EAD;p tr&#xEC;nh CODESYS, h&#x1ED7; tr&#x1EE3; &#x1EE9;ng d&#x1EE5;ng container v&#xE0; Node-RED &#x2013; k&#x1EBF;t n&#x1ED1;i tr&#x1EF1;c ti&#x1EBF;p I/O u-remote.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["iot-giam-sat-nang-luong", "tu-dong-hoa-dieu-khien"]}}], "size": 4}