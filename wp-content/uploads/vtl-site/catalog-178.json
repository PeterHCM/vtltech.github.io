{"items": [{"html": "<a class=\"v-card\" href=\"/en/products/surge-protection/eaton-mtl-tp48-surge-protector-for-field-transmitters/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/hnjiowjb/vtl-mtl-tp48.webp?width=600&amp;v=1dd5fbc149f82fa\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL TP48 surge protector for field transmitters</h3>\n <p class=\"v-card__text\">MTL TP48 protects field-mounted transmitters from lightning surges: screws into a spare conduit entry, self-restoring, Ex ia/Ex d versions with ATEX, IECEx, FM, CSA.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["surge-protection-earthing"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/surge-protection/eaton-mtl-sd32-signal-surge-protector/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/hyehm010/mtl-sd32.webp?width=600&amp;v=1dd64867517a5b5\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL SD32 signal surge protector</h3>\n <p class=\"v-card__text\">SD32: surge protection for 32 V signals (4&#x2013;20 mA, I/O) &#x2013; with built-in fuse and loop disconnect. 7 mm slim, DIN rail, 5 kA, Ex ia.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["hazardous-area-safety", "surge-protection-earthing"]}, "model": "SD32"}, {"html": "<a class=\"v-card\" href=\"/en/products/surge-protection/eaton-mtl-sd-series-signal-surge-protectors/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/gr3nn1ct/vtl-mtl-sd-range.webp?width=600&amp;v=1dd5fbc146593fc\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL SD series signal surge protectors</h3>\n <p class=\"v-card__text\">MTL SD series: 7 mm slim surge protectors for signal and data lines, 20 kA surge rating, ATEX/IECEx &#x2013; for 4&#x2013;20 mA, RS485, Ethernet and HART.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["surge-protection-earthing"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/surge-protection/eaton-mtl-sd-modular-sdm-surge-protectors/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/3qpo5pmc/sdm-range-617x400.jpg?width=600&amp;v=1dd5fbbc9da8039\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL SD Modular (SDM) surge protectors</h3>\n <p class=\"v-card__text\">MTL SD Modular (SDM): pluggable 7 mm signal surge protectors &#x2013; replace without disturbing wiring, make-before-break, optional LED and fuse.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["surge-protection-earthing"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/surge-protection/eaton-mtl-iop-digital-analogue-i-o-surge-protector/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/4qgdbooy/mtl-iop-1.webp?width=600&amp;v=1dd5fc2e6beac60\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL IOP digital &amp; analogue I/O surge protector</h3>\n <p class=\"v-card__text\">MTL IOP: economical surge protection for digital and analogue I/O &#x2013; 20 kA hybrid circuit, 6 mm per loop, removable terminals, Ex ia and Ex n approvals.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["surge-protection-earthing"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/surge-protection/eaton-mtl-fieldbus-surge-protection/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/3dijgude/mtl-fp32.webp?width=600&amp;v=1dd6143457ac03c\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL FP32, FS32, TP32 fieldbus surge protection</h3>\n <p class=\"v-card__text\">Surge protection for fieldbus trunks and spurs: FP32 DIN-rail, FS32 plug-in for Megablocks and barriers, TP32 at the transmitter.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["hazardous-area-safety", "surge-protection-earthing"]}, "model": "FP32 / FS32 / TP32"}, {"html": "<a class=\"v-card\" href=\"/en/products/surge-protection/eaton-mtl-sd16r-signal-surge-protector/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/snbnnq3q/mtl-sd16r-1.webp?width=600&amp;v=1dd5fc2e7a91cf2\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL SD16R signal surge protector</h3>\n <p class=\"v-card__text\">Eaton MTL SD16R: 7 mm data surge protector for RS232/RS485 and 2-wire loops, 50 MHz bandwidth, 20 kA surge rating, ATEX/IECEx.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["surge-protection-earthing"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/surge-protection/eaton-mtl-mldt28500-data-surge-tester/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/3qpo5pmc/sdm-range-617x400.jpg?width=600&amp;v=1dd5fbbc9da8039\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL MLDT28500 data surge tester</h3>\n <p class=\"v-card__text\">MLDT28500: portable tester for signal surge protectors &#x2013; continuity and leakage tests at 7/16/32/55 V with Pass/Fail LED indication.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["surge-protection-earthing"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/surge-protection/weidmuller-varitector-surge-protection/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/qxphprxi/vtl_weidmuller_suge_protection.jpg?width=600&amp;v=1dd5fbbc7e7188a\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Weidm&#xFC;ller</span>         <h3 class=\"v-card__title\">Weidm&#xFC;ller VARITECTOR surge protection</h3>\n <p class=\"v-card__text\">Weidm&#xFC;ller VARITECTOR surge protection for energy systems (75&#x2013;1,500 V), instrumentation &amp; control and data interfaces; PU AC S-line only 18 mm per pole.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["weidmueller"], "giaiphap": ["surge-protection-earthing"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/surge-protection/eaton-mtl-zonedefender-pro-surge-protectors/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/ss2dyrbo/mtl-zdpro-1.webp?width=600&amp;v=1dd5fc2e92cece9\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL ZoneDefender PRO surge protectors</h3>\n <p class=\"v-card__text\">ZoneDefender PRO: Type 2 AC power surge protection, 80/100/120 kA per phase, 4-mode protection, EMI/RFI filtering, LED and alarm contacts, NEMA 4X/IP66 enclosure.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["surge-protection-earthing"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/surge-protection/lytech-retractable-bypass-conductor-rbc/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/fj1deyvm/lytech-12.jpg?width=600&amp;v=1dd5fbbcaafd65f\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Lytech</span>         <h3 class=\"v-card__title\">LYTECH Retractable Bypass Conductor (RBC)</h3>\n <p class=\"v-card__text\">LYTECH RBC: a retractable bypass conductor providing a direct, visibly inspectable bond between tank shell and floating roof &#x2013; reducing lightning-induced rim-seal fires.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["lytech"], "giaiphap": ["surge-protection-earthing"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/surge-protection/eaton-mtl-slp-power-surge-protectors/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/hamixolk/mtlslp-1.webp?width=600&amp;v=1dd5fc1659a8d0d\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL SLP power surge protectors</h3>\n <p class=\"v-card__text\">Surge protectors for power feeds of control and instrumentation equipment &#x2013; DIN-rail mounted in cabinets to protect PLC, DCS, power supplies and field devices.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["surge-protection-earthing"]}, "model": "SLP07D / SLP32D"}, {"html": "<a class=\"v-card\" href=\"/en/products/surge-protection/eaton-mtl-ma15-mains-filter-surge-protector/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/wq5dfazj/mtl-ma15.webp?width=600&amp;v=1dd614345d10c84\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL MA15 AC/DC mains filter and surge protector</h3>\n <p class=\"v-card__text\">Combined surge protection and noise filtering for AC/DC supplies to electronics and computer networks &#x2013; MA15E for Zone 2.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["power-distribution-quality", "surge-protection-earthing"]}, "model": "MA15 / MA15E"}, {"html": "<a class=\"v-card\" href=\"/en/products/surge-protection/eaton-mtl-ls-led-surge-protectors/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/i2amqriq/mtl-ls-led.webp?width=600&amp;v=1dd614345dc8731\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL LS range LED surge protectors</h3>\n <p class=\"v-card__text\">Compact surge protectors for industrial and street LED lighting &#x2013; 10&#x2013;20 kA per mode, IP66, series or parallel connection.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["surge-protection-earthing"]}, "model": "LS05K / LS10N / LS20N"}, {"html": "<a class=\"v-card\" href=\"/en/products/surge-protection/eaton-mtl-sd32x-surge-protector/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/hyehm010/mtl-sd32.webp?width=600&amp;v=1dd64867517a5b5\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL SD32X signal surge protector</h3>\n <p class=\"v-card__text\">SD32X: surge protection for 32 V signals (4&#x2013;20 mA, I/O) &#x2013; low series resistance, no fuse. 7 mm slim, DIN rail, 5 kA, Ex ia.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["hazardous-area-safety", "surge-protection-earthing"]}, "model": "SD32X"}, {"html": "<a class=\"v-card\" href=\"/en/products/surge-protection/eaton-mtl-sd32r-surge-protector/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/hyehm010/mtl-sd32.webp?width=600&amp;v=1dd64867517a5b5\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL SD32R signal surge protector</h3>\n <p class=\"v-card__text\">SD32R: surge protection for 32 V signals (4&#x2013;20 mA, I/O) &#x2013; high bandwidth for communication and data signals. 7 mm slim, DIN rail, 5 kA, Ex ia.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["hazardous-area-safety", "surge-protection-earthing"]}, "model": "SD32R"}, {"html": "<a class=\"v-card\" href=\"/en/products/surge-protection/eaton-mtl-sd32r3-surge-protector/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/hyehm010/mtl-sd32.webp?width=600&amp;v=1dd64867517a5b5\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL SD32R3 signal surge protector</h3>\n <p class=\"v-card__text\">SD32R3: surge protection for 32 V signals (4&#x2013;20 mA, I/O) &#x2013; 3-terminal version, 60 V residual voltage. 7 mm slim, DIN rail, 5 kA, Ex ia.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["hazardous-area-safety", "surge-protection-earthing"]}, "model": "SD32R3"}, {"html": "<a class=\"v-card\" href=\"/en/products/surge-protection/eaton-mtl-sd32t3-surge-protector/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/hyehm010/mtl-sd32.webp?width=600&amp;v=1dd64867517a5b5\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL SD32T3 signal surge protector</h3>\n <p class=\"v-card__text\">SD32T3: surge protection for 32 V signals (4&#x2013;20 mA, I/O) &#x2013; for 3-wire transmitters, 3-terminal, 75 V residual voltage. 7 mm slim, DIN rail, 5 kA, Ex ia.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["hazardous-area-safety", "surge-protection-earthing"]}, "model": "SD32T3"}], "size": 18}