{"items": [{"html": "<a class=\"v-card\" href=\"/en/products/measurement/baumer-pressure-gauges/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/x4li1ajp/baumer_barner.png?width=600&amp;v=1dd5fbbcb8e212d\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Baumer</span>         <h3 class=\"v-card__title\">Baumer pressure gauges</h3>\n <p class=\"v-card__text\">Baumer pressure and differential pressure gauges for oil &amp; gas, petrochemicals and chemicals: stainless steel, liquid-filled, many ranges and connections, made in Europe.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["baumer"], "giaiphap": ["measurement-flow"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/measurement/liquid-controls-positive-displacement-flow-meters/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/vy1gwts0/liquid_controls_pd_flow-meter_360x250.png?width=600&amp;v=1dd5fbbcaa6113d\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Liquid Controls</span>         <h3 class=\"v-card__title\">Liquid Controls positive displacement flow meters</h3>\n <p class=\"v-card__text\">Liquid Controls positive displacement meters (M, MA, MS series) for fuels: accurate and durable, up to 3,785 L/min, for custody transfer.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["liquid-controls"], "giaiphap": ["measurement-flow"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/measurement/baumer-temperature-sensors/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/hb1jbbx1/baumer_rtd_tcr6_temperaturesensor720wx540h.png?width=600&amp;v=1dd5fbbcb9953e2\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Baumer</span>         <h3 class=\"v-card__title\">Baumer temperature sensors</h3>\n <p class=\"v-card__text\">Baumer temperature sensors: Pt100/Pt1000, 4&#x2013;20 mA or HART output, DIN form B head, immersion depth up to 3,000 mm for oil &amp; gas and chemicals.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["baumer"], "giaiphap": ["measurement-flow"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/measurement/eaton-egl-explosion-proof-static-grounding-indicators/\">\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Crouse-Hinds</span>         <h3 class=\"v-card__title\">Eaton EGL explosion-proof static grounding indicators</h3>\n <p class=\"v-card__text\">Eaton Crouse-Hinds EGL: automatic static grounding verification for tank trucks during loading, pump/valve interlock relay, green/red LEDs, IP65 NEMA 4X/7 housing.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["crouse-hinds"], "giaiphap": ["measurement-flow"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/measurement/baumer-temperature-gauges/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/acyjd0nd/vtl_baumer_temperature_gauge_banner.jpg?width=600&amp;v=1dd5fbbcb831ea7\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Baumer</span>         <h3 class=\"v-card__title\">Baumer temperature gauges</h3>\n <p class=\"v-card__text\">Baumer temperature gauges made in Europe: &#x2212;200 &#x2026; 800 &#xB0;C range, IP68, many connections, for oil &amp; gas, power, chemicals, paper and marine.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["baumer"], "giaiphap": ["measurement-flow"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/measurement/faure-herman-helical-turbine-flow-meters/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/1r3inqop/vtl_faure_herma_tzn-6.jpg?width=600&amp;v=1dd5fbbca9832c9\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Faure Herman</span>         <h3 class=\"v-card__title\">Faure Herman helical turbine flow meters</h3>\n <p class=\"v-card__text\">Faure Herman helical turbine meters: custody-transfer accuracy with &#xB1;0.15 % linearity, 50 L/h &#x2013; 5,500 m&#xB3;/h, sizes 1/2&#x2033;&#x2013;18&#x2033;, calibrated at actual viscosity.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["faure-herman"], "giaiphap": ["measurement-flow"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/measurement/faure-herman-ultrasonic-flow-meters/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/vwahntog/vtl_faure_herma_fh8400.jpg?width=600&amp;v=1dd5fbbca92263d\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Faure Herman</span>         <h3 class=\"v-card__title\">Faure Herman ultrasonic flow meters</h3>\n <p class=\"v-card__text\">Faure Herman FH8400 ultrasonic flow meters: 3 beams, bi-directional, no pressure drop, Reynolds calibration &#x2013; for custody transfer and process measurement.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["faure-herman"], "giaiphap": ["measurement-flow"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/measurement/smart-vortex-flow-meter-svf128/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/fdmljd3r/s_svf128_1.jpg?width=600&amp;v=1dd5fbbca61593d\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n        <h3 class=\"v-card__title\">Smart vortex flow meter SVF128</h3>\n <p class=\"v-card__text\">SVF128 smart vortex meter measures steam, gas and liquid flow using the K&#xE1;rm&#xE1;n principle, with integrated pressure/temperature and wireless IoT connectivity.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["measurement-flow"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/measurement/eaton-mtl660-loop-powered-indicators/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/zqknheyo/mtl660.webp?width=600&amp;v=1dd614344c5f101\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL660 loop-powered IS indicators</h3>\n <p class=\"v-card__text\">Loop-powered digital indicators for hazardous and general-purpose areas &#x2013; large display, IP67 aluminium case, optional backlight.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["hazardous-area-safety", "measurement-flow"]}, "model": "MTL660"}, {"html": "<a class=\"v-card\" href=\"/en/products/measurement/eaton-mtl-process-gas-analysers/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/5noprjck/mtl-gir6000.webp?width=600&amp;v=1dd614345f77fc2\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL process gas analysers</h3>\n <p class=\"v-card__text\">Application-specific gas analysers: GIR6000 biogas, G1010/Z4010 oxygen, K1550 hydrogen katharometer, KK650 for chlorine production, K1650 generator purge monitors.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["hazardous-area-safety", "measurement-flow"]}, "model": "GIR6000 / G1010 / Z4010 / K1550 / KK650 / K1650"}, {"html": "<a class=\"v-card\" href=\"/en/products/measurement/azbil-flow-measurement/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/w4ykjlmg/azbil-magnew-mgg.webp?width=600&amp;v=1dd61439f0ad76c\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Azbil</span>         <h3 class=\"v-card__title\">Azbil flow measurement</h3>\n <p class=\"v-card__text\">MagneW electromagnetic flowmeters (MGG, 2-wire MTG, sanitary MGS, open-channel NNK), AX22/AX24 vortex flowmeters, MVF/MVC thermal mass flowmeters and DP flow.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["azbil"], "giaiphap": ["measurement-flow"]}, "model": "MGG / MTG / MGS / AX22 / AX24 / MVF / MVC"}, {"html": "<a class=\"v-card\" href=\"/en/products/measurement/azbil-level-temperature/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/5hhfgwv3/azbil-gtx-level.webp?width=600&amp;v=1dd61439f3f683f\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Azbil</span>         <h3 class=\"v-card__title\">Azbil level and temperature measurement</h3>\n <p class=\"v-card__text\">GTX differential-pressure, JTL immersion and SLX displacement level transmitters; ATT08 temperature transmitters and YY / YYQS sanitary thermocouple and RTD sensors.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["azbil"], "giaiphap": ["measurement-flow"]}, "model": "GTX / JTL / SLX / ATT08 / YY"}, {"html": "<a class=\"v-card\" href=\"/en/products/measurement/azbil-gtx-pressure-transmitters/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/vmrlosrn/azbil-gtx-pressure.webp?width=600&amp;v=1dd61439f6bcd5f\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Azbil</span>         <h3 class=\"v-card__title\">Azbil GTX pressure transmitters</h3>\n <p class=\"v-card__text\">GTX pressure transmitters: gauge, absolute, differential, remote diaphragm seal, flange-mounted, sanitary and multivariable types.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["azbil"], "giaiphap": ["measurement-flow"]}, "model": "GTX series"}], "size": 13}