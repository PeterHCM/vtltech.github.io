{"items": [{"html": "<a class=\"v-card\" href=\"/en/products/safety-barriers/eaton-mtl-949x-ps-is-power-supplies/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/dhdeojkm/mtl9493-ps.webp?width=600&amp;v=1dd648675476a26\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL 949x-PS intrinsically safe power supplies</h3>\n <p class=\"v-card__text\">Isolated IS power supplies: 24 V DC in, Ex ia 4.8 &#x2013; 17.7 V out for devices in Zone 0/1, gas groups IIB/IIC; mount in safe area or Zone 2.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["automation-control", "hazardous-area-safety"]}, "model": "MTL 9491/9492/9493-PS"}, {"html": "<a class=\"v-card\" href=\"/en/products/safety-barriers/eaton-mtl4500-is-isolators/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/1fxm0cgb/mtl4500-is.webp?width=600&amp;v=1dd64867522903f\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL4500 backplane-mounted IS isolators</h3>\n <p class=\"v-card__text\">Backplane-mounted intrinsic safety isolators for DCS, ESD and F&amp;G &#x2013; highest channel density, 3-port isolation, low power, many SIL-assessed models.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["automation-control", "hazardous-area-safety"]}, "model": "MTL4500"}, {"html": "<a class=\"v-card\" href=\"/en/products/safety-barriers/eaton-mtl-intrinsically-safe-isolators-mtl5500/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/ws3geiqq/mtl5500-is.webp?width=600&amp;v=1dd648675313a02\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL5500 DIN-rail IS isolators</h3>\n <p class=\"v-card__text\">MTL5500 DIN-rail intrinsic safety isolators: slim single and multi-channel modules, 3-port isolation and removable connectors &#x2013; from single loops to full cabinets.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["automation-control", "hazardous-area-safety"]}, "model": "MTL5500"}, {"html": "<a class=\"v-card\" href=\"/en/products/safety-barriers/eaton-mtl7700-zener-barriers/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/5orcw1lv/mtl7700-zener.webp?width=600&amp;v=1dd6486753c480a\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL7700 DIN-rail zener barriers</h3>\n <p class=\"v-card__text\">MTL7700 DIN-rail zener barriers divert excess energy safely to earth using zener diodes, resistors and fuses &#x2013; compact, economical, removable terminals, IS earth via the rail.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["automation-control", "hazardous-area-safety"]}, "model": "MTL7700"}, {"html": "<a class=\"v-card\" href=\"/en/products/safety-barriers/eaton-mtl-is-fieldbus-barriers/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/ybzch14o/mtlfb-1.webp?width=600&amp;v=1dd5fc162e03469\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL intrinsically safe fieldbus barriers</h3>\n <p class=\"v-card__text\">Fieldbus barriers providing intrinsically safe spurs from a high-energy trunk for FOUNDATION&#x2122; fieldbus H1 devices &#x2013; mount in Zone 1/21, spurs into Zone 0.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["automation-control", "hazardous-area-safety"]}, "model": "9373-FB3 / 9377-FB3 / 937x-FB2 / 9372-FB / 9387-FB"}], "size": 5}