{"items": [{"html": "<a class=\"v-card\" href=\"/en/products/automation/mtl-sum5-smart-universal-marshalling/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/3gcbhanl/sum5-banner.jpg?width=600&amp;v=1dd5fbbc9ef9c35\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">MTL SUM5 smart universal marshalling</h3>\n <p class=\"v-card__text\">MTL SUM5: one marshalling cabinet for five functions (IS isolation, signal conditioning, relays, surge protection, loop disconnect) with plug-and-play modules &#x2013; 50 % fewer cabinets.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["automation-control"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/automation/weidmuller-pro-switch-mode-power-supplies/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/o2jltegw/weidmuller_protop-480-w.jpg?width=600&amp;v=1dd5fbbc7f59386\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n        <h3 class=\"v-card__title\">Weidm&#xFC;ller PRO switch-mode power supplies</h3>\n <p class=\"v-card__text\">Weidm&#xFC;ller PRO switch-mode power supplies (PROeco, PROtop, PROmax): 24 V DC from 72 W to 960 W, high efficiency, DIN-rail mounting for control panels.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["automation-control"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/automation/weidmuller-relays/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/qyzn4ua4/weidmuller_trs-24vdc-1co.jpg?width=600&amp;v=1dd5fbbc80f8ff0\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Weidm&#xFC;ller</span>         <h3 class=\"v-card__title\">Weidm&#xFC;ller relays</h3>\n <p class=\"v-card__text\">Weidm&#xFC;ller TERMSERIES and MICROSERIES relays: slim 6.4 mm interface and solid-state relays in terminal format, 24 V DC / 230 V AC coils for control panels.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["weidmueller"], "giaiphap": ["automation-control"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/automation/weidmuller-signal-conditioners-act20/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/ucpp55oa/vtl_weidmuller_analogue_signal_conditioning.jpg?width=600&amp;v=1dd5fbbc7fcfabc\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Weidm&#xFC;ller</span>         <h3 class=\"v-card__title\">Weidm&#xFC;ller signal conditioners (ACT20)</h3>\n <p class=\"v-card__text\">Weidm&#xFC;ller ACT20 signal conditioners and isolators: 4&#x2013;20 mA/0&#x2013;10 V, temperature and frequency; ACT20C with Ethernet/Modbus TCP and FDT/DTM configuration.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["weidmueller"], "giaiphap": ["automation-control"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/automation/eaton-mtl-gecma-is-10-1-explosion-proof-tablet/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/3shbtkap/vtl_eaton_mtl_gecma_is_10-1_inch.jpg?width=600&amp;v=1dd5fbbca2382c8\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL GECMA IS 10.1&quot; explosion-proof tablet</h3>\n <p class=\"v-card__text\">GECMA IS 10.1&quot; explosion-proof tablet: Zone 1 (Zone 0 with leather case) ATEX/IECEx certified, 10.1&quot; AHVA display, optional cameras.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["automation-control"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/automation/eaton-mtl-lightning-and-surge-protection-devices/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/v1jfouer/vtl-mtl-sd150x.webp?width=600&amp;v=1dd5fbc1490aa3f\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n        <h3 class=\"v-card__title\">Eaton MTL lightning and surge protection devices</h3>\n <p class=\"v-card__text\">Eaton MTL surge protection for signal, data and power lines: SD, SDM, TP48, IOP, SLP and ZoneDefender &#x2013; complete protection for control systems.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["automation-control"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/automation/rtk-process-alarm-annunciators-mtl/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/dtemsai3/rtk-725b.webp?width=600&amp;v=1dd6486755ff82f\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">RTK process alarm annunciators (MTL)</h3>\n <p class=\"v-card__text\">RTK process alarm annunciators (Eaton MTL): clear, fast fault indication for control rooms and field stations.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["automation-control"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/automation/eaton-mtl-remote-i-o-systems/\">\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL remote I/O systems</h3>\n <p class=\"v-card__text\">Eaton MTL remote I/O for hazardous areas: I/O located in the field in Zone 1/2, less multicore cable, DCS connection via fieldbus/Ethernet.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["automation-control"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/automation/weidmuller-terminal-blocks/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/rrtn4ge0/wdu-2-5.jpg?width=600&amp;v=1dd5fbbc88f9fb0\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n        <h3 class=\"v-card__title\">Weidm&#xFC;ller terminal blocks</h3>\n <p class=\"v-card__text\">Weidm&#xFC;ller Klippon&#xAE; Connect terminal blocks (W, Z, A series): screw, tension-clamp and push-in, PE, fuse and multi-tier terminals for control panels.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["automation-control"]}}, {"html": "<a class=\"v-card\" href=\"/en/products/automation/eaton-mtl4850-hart-multiplexer/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/hfjnnv5n/mtl4850-1.webp?width=600&amp;v=1dd5fc1618200f1\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL4850 SIL3 HART multiplexer</h3>\n <p class=\"v-card__text\">32-channel SIL3 HART multiplexer that links smart field devices to asset management systems without disturbing the 4&#x2013;20 mA control loops.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["automation-control"]}, "model": "MTL4850 / MTL4854"}, {"html": "<a class=\"v-card\" href=\"/en/products/automation/eaton-mtl-9470-is-gigabit-ethernet/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/jp0faftd/mtl9470-1.webp?width=600&amp;v=1dd5fc1634d44f7\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL 9470 gigabit intrinsically safe Ethernet</h3>\n <p class=\"v-card__text\">Intrinsically safe gigabit Ethernet for Zone 1: gateways, fibre media converter, managed switch, isolator and Wi-Fi &#x2013; with PoEx&#x2122; power and data over one cable.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["automation-control", "hazardous-area-safety"]}, "model": "9471 / 9475 / 9476 / 9478 / 9479"}, {"html": "<a class=\"v-card\" href=\"/en/products/automation/eaton-mtl-gecma-hmi-workstations/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/c4vbiftj/gecma-1.webp?width=600&amp;v=1dd5fc16405e385\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">Eaton MTL GECMA hazardous-area HMI workstations</h3>\n <p class=\"v-card__text\">HMI workstations for Zone 1/2/21/22: 19&#x2013;24&quot; displays, IP66 stainless steel, fibre or copper link to a safe-area PC/server (Remote Terminal) or thin-client operation.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["automation-control", "hazardous-area-safety"]}, "model": "GECMA RT / GECMA TC"}, {"html": "<a class=\"v-card\" href=\"/en/products/automation/eaton-dilm-contactors/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/cuioxwv4/dilm-1.webp?width=600&amp;v=1dd5fc16975fbbd\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">Eaton DILM contactors</h3>\n <p class=\"v-card__text\">Eaton DILM (Moeller series) contactors for switching motors and industrial loads, AC/DC coils with matching accessories and overload relays.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["power-distribution"], "giaiphap": ["automation-control", "power-distribution-quality"]}, "model": "DILM"}, {"html": "<a class=\"v-card\" href=\"/en/products/automation/eaton-pkzm-motor-protective-circuit-breakers/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/vtkloqal/pkzm-1.webp?width=600&amp;v=1dd5fc169e650c4\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">Eaton PKZM motor protective circuit breakers</h3>\n <p class=\"v-card__text\">PKZM motor protective circuit breakers (Moeller series): overload and short-circuit protection in one device, adjustable current, pairs with DILM contactors.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filters": {"hang": ["power-distribution"], "giaiphap": ["automation-control", "power-distribution-quality"]}, "model": "PKZM0 / PKZM01 / PKZM4"}, {"html": "<a class=\"v-card\" href=\"/en/products/automation/eaton-easye4-programmable-relay/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/getf1zs4/easye4-1.webp?width=600&amp;v=1dd5fc16a95831a\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">Eaton easyE4 programmable relay</h3>\n <p class=\"v-card__text\">easyE4 programmable relay for small automation tasks: built-in Ethernet, I/O expansion and easySoft programming in several languages.</p>         <span class=\"v-card__more\">View details →</span>\n    </div>\n</a>", "filte