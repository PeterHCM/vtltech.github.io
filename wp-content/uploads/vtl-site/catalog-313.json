{"items": [{"html": "<a class=\"v-card\" href=\"/san-pham/phan-phoi-dien/ups-1-pha-eaton-9px/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/m24mmpzg/ups9px-1.webp?width=600&amp;v=1dd5fc1663c11b3\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">UPS 1 pha Eaton 9PX (1&#x2013;11 kVA)</h3>\n <p class=\"v-card__text\">UPS online chuy&#x1EC3;n &#x111;&#x1ED5;i k&#xE9;p 1 pha, h&#x1EC7; s&#x1ED1; c&#xF4;ng su&#x1EA5;t 1.0, d&#x1EA1;ng rack/tower &#x2013; b&#x1EA3;o v&#x1EC7; m&#xE1;y ch&#x1EE7;, t&#x1EE7; m&#x1EA1;ng v&#xE0; h&#x1EC7; th&#x1ED1;ng &#x111;i&#x1EC1;u khi&#x1EC3;n c&#xF4;ng nghi&#x1EC7;p.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["phan-phoi-dien-chat-luong-dien-nang"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/phan-phoi-dien/ups-3-pha-eaton-93pm/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/dymbbi2o/ups93pm-1.webp?width=600&amp;v=1dd5fc166c87f1a\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">UPS 3 pha Eaton 93PM (30&#x2013;500 kW)</h3>\n <p class=\"v-card__text\">UPS 3 pha d&#x1EA1;ng module, m&#x1EDF; r&#x1ED9;ng c&#xF4;ng su&#x1EA5;t v&#xE0; d&#x1EF1; ph&#xF2;ng N&#x2B;1 linh ho&#x1EA1;t, hi&#x1EC7;u su&#x1EA5;t cao &#x2013; cho trung t&#xE2;m d&#x1EEF; li&#x1EC7;u, nh&#xE0; m&#xE1;y v&#xE0; t&#xF2;a nh&#xE0;.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["phan-phoi-dien-chat-luong-dien-nang"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/phan-phoi-dien/aptomat-khoi-mccb-eaton-nzm/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/gkbh05aa/nzm-1.webp?width=600&amp;v=1dd5fc1678904da\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">Aptomat kh&#x1ED1;i MCCB Eaton NZM</h3>\n <p class=\"v-card__text\">D&#xF2;ng MCCB Eaton NZM (Moeller series) b&#x1EA3;o v&#x1EC7; h&#x1EC7; th&#x1ED1;ng ph&#xE2;n ph&#x1ED1;i &#x111;i&#x1EC7;n, &#x111;&#x1ED9;ng c&#x1A1; v&#xE0; m&#xE1;y ph&#xE1;t, ti&#xEA;u chu&#x1EA9;n IEC/EN 60947-2.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["phan-phoi-dien-chat-luong-dien-nang"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/phan-phoi-dien/may-cat-khong-khi-acb-eaton-izmx/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/qoenvvqx/izmx-1.webp?width=600&amp;v=1dd5fc1684342f9\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">M&#xE1;y c&#x1EAF;t kh&#xF4;ng kh&#xED; ACB Eaton IZMX</h3>\n <p class=\"v-card__text\">M&#xE1;y c&#x1EAF;t kh&#xF4;ng kh&#xED; Eaton IZMX cho t&#x1EE7; ph&#xE2;n ph&#x1ED1;i h&#x1EA1; th&#x1EBF; t&#x1ED5;ng &#x2013; b&#x1ED9; b&#x1EA3;o v&#x1EC7; &#x111;i&#x1EC7;n t&#x1EED;, &#x111;o l&#x1B0;&#x1EDD;ng v&#xE0; truy&#x1EC1;n th&#xF4;ng t&#xED;ch h&#x1EE3;p.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["phan-phoi-dien-chat-luong-dien-nang"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/phan-phoi-dien/aptomat-tep-mcb-eaton-xeffect-faz/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/wadaxecl/faz-1.webp?width=600&amp;v=1dd5fc168ea7ec4\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">Aptomat t&#xE9;p MCB Eaton xEffect FAZ</h3>\n <p class=\"v-card__text\">MCB Eaton xEffect FAZ cho t&#x1EE7; &#x111;i&#x1EC7;n c&#xF4;ng nghi&#x1EC7;p v&#xE0; t&#xF2;a nh&#xE0; &#x2013; nhi&#x1EC1;u &#x111;&#x1EB7;c t&#xED;nh c&#x1EAF;t, kh&#x1EA3; n&#x103;ng c&#x1EAF;t cao, ph&#x1EE5; ki&#x1EC7;n &#x111;&#x1ED3;ng b&#x1ED9;.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["phan-phoi-dien-chat-luong-dien-nang"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/phan-phoi-dien/tu-dong-cat-trung-the-eaton-power-xpert-ux/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/bpve4kft/pd-power-xpert-ux.webp?width=600&amp;v=1dd614374134d9c\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">T&#x1EE7; &#x111;&#xF3;ng c&#x1EAF;t trung th&#x1EBF; Eaton Power Xpert UX</h3>\n <p class=\"v-card__text\">T&#x1EE7; trung th&#x1EBF; c&#xE1;ch &#x111;i&#x1EC7;n kh&#xF4;ng kh&#xED; cho ph&#xE2;n ph&#x1ED1;i s&#x1A1; c&#x1EA5;p &#x111;&#x1EBF;n 24 kV, ch&#x1EE9;ng nh&#x1EAD;n IEC 62271-100/-200, m&#xE1;y c&#x1EAF;t ch&#xE2;n kh&#xF4;ng v&#xE0; contactor ch&#xE2;n kh&#xF4;ng.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["phan-phoi-dien-chat-luong-dien-nang"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/phan-phoi-dien/tu-rmu-trung-the-eaton-xiria/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/dugfuv2j/pd-xiria-plus.webp?width=600&amp;v=1dd6143741ff998\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">T&#x1EE7; RMU trung th&#x1EBF; Eaton Xiria</h3>\n <p class=\"v-card__text\">T&#x1EE7; RMU cho l&#x1B0;&#x1EDB;i ph&#xE2;n ph&#x1ED1;i th&#x1EE9; c&#x1EA5;p &#x111;&#x1EBF;n 24 kV, d&#xF9;ng c&#xF4;ng ngh&#x1EC7; c&#x1EAF;t ch&#xE2;n kh&#xF4;ng v&#xE0; c&#xE1;ch &#x111;i&#x1EC7;n r&#x1EAF;n, kh&#xF4;ng d&#xF9;ng kh&#xED; SF6.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["phan-phoi-dien-chat-luong-dien-nang"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/phan-phoi-dien/may-cat-chan-khong-trung-the-eaton/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/omrpmtul/pd-vcp-w.webp?width=600&amp;v=1dd6143742ded78\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">M&#xE1;y c&#x1EAF;t ch&#xE2;n kh&#xF4;ng trung th&#x1EBF; Eaton</h3>\n <p class=\"v-card__text\">M&#xE1;y c&#x1EAF;t ch&#xE2;n kh&#xF4;ng trung th&#x1EBF; Eaton cho t&#x1EE7; &#x111;&#xF3;ng c&#x1EAF;t v&#xE0; c&#x1EA3;i t&#x1EA1;o, c&#x1A1; c&#x1EA5;u t&#xED;ch n&#x103;ng l&#xF2; xo, bu&#x1ED3;ng c&#x1EAF;t ch&#xE2;n kh&#xF4;ng do Eaton s&#x1EA3;n xu&#x1EA5;t.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["phan-phoi-dien-chat-luong-dien-nang"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/phan-phoi-dien/tu-phan-phoi-ha-the-eaton-xenergy-main/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/nd5f0kxe/pd-xenergy-main.webp?width=600&amp;v=1dd6143745c96fe\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">T&#x1EE7; ph&#xE2;n ph&#x1ED1;i h&#x1EA1; th&#x1EBF; Eaton xEnergy Main</h3>\n <p class=\"v-card__text\">H&#x1EC7; t&#x1EE7; ph&#xE2;n ph&#x1ED1;i v&#xE0; &#x111;i&#x1EC1;u khi&#x1EC3;n &#x111;&#x1ED9;ng c&#x1A1; h&#x1EA1; th&#x1EBF; theo IEC 61439, d&#x1EA1;ng c&#x1ED1; &#x111;&#x1ECB;nh ho&#x1EB7;c r&#xFA;t ra, t&#x1EDB;i 7.100 A, d&#xF9;ng ACB IZMX, MCCB NZM c&#x1EE7;a Eaton.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["phan-phoi-dien-chat-luong-dien-nang"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/phan-phoi-dien/ro-le-bao-ve-eaton-edr-3000-edr-5000/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/hadn2r3f/pd-edr-5000.webp?width=600&amp;v=1dd6143746bfa77\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">R&#x1A1;-le b&#x1EA3;o v&#x1EC7; Eaton EDR 3000 / EDR 5000</h3>\n <p class=\"v-card__text\">R&#x1A1;-le b&#x1EA3;o v&#x1EC7; ph&#xE2;n ph&#x1ED1;i t&#xED;ch h&#x1EE3;p b&#x1EA3;o v&#x1EC7;, &#x111;o l&#x1B0;&#x1EDD;ng v&#xE0; &#x111;i&#x1EC1;u khi&#x1EC3;n trong m&#x1ED9;t v&#x1ECF; nh&#x1ECF; g&#x1ECD;n, cho m&#x1ECD;i c&#x1EA5;p &#x111;i&#x1EC7;n &#xE1;p.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["phan-phoi-dien-chat-luong-dien-nang"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/phan-phoi-dien/dong-ho-chat-luong-dien-nang-eaton-power-xpert-meter/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/imqfxhf0/pd-pxm-2290.webp?width=600&amp;v=1dd6143747972c1\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">&#x110;&#x1ED3;ng h&#x1ED3; &#x111;o v&#xE0; gi&#xE1;m s&#xE1;t ch&#x1EA5;t l&#x1B0;&#x1EE3;ng &#x111;i&#x1EC7;n n&#x103;ng Eaton Power Xpert Meter</h3>\n <p class=\"v-card__text\">&#x110;&#x1ED3;ng h&#x1ED3; &#x111;a n&#x103;ng v&#xE0; ph&#xE2;n t&#xED;ch ch&#x1EA5;t l&#x1B0;&#x1EE3;ng &#x111;i&#x1EC7;n n&#x103;ng: &#x111;o n&#x103;ng l&#x1B0;&#x1EE3;ng, s&#xF3;ng h&#xE0;i, s&#x1EE5;t/d&#xE2;ng &#xE1;p, ghi d&#x1EA1;ng s&#xF3;ng, truy&#x1EC1;n th&#xF4;ng Ethernet/Modbus.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["iot-giam-sat-nang-luong", "phan-phoi-dien-chat-luong-dien-nang"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/phan-phoi-dien/cau-chi-ha-the-trung-the-eaton-bussmann/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/llmnib0u/pd-nh-fuse.webp?width=600&amp;v=1dd614374a32662\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">C&#x1EA7;u ch&#xEC; h&#x1EA1; th&#x1EBF; v&#xE0; trung th&#x1EBF; Eaton Bussmann</h3>\n <p class=\"v-card__text\">C&#x1EA7;u ch&#xEC; Bussmann: c&#x1EA7;u ch&#xEC; NH gG/aM, c&#x1EA7;u ch&#xEC; t&#xE1;c &#x111;&#x1ED9;ng nhanh 170M b&#x1EA3;o v&#x1EC7; b&#xE1;n d&#x1EAB;n, c&#x1EA7;u ch&#xEC; trung th&#x1EBF; h&#x1EA1;n d&#xF2;ng cho m&#xE1;y bi&#x1EBF;n &#xE1;p, &#x111;&#x1ED9;ng c&#x1A1;.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["phan-phoi-dien-chat-luong-dien-nang"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/phan-phoi-dien/sieu-tu-dien-eaton-bussmann/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/e50pp32o/pd-xl60-supercap.webp?width=600&amp;v=1dd614374c2d4f2\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">Si&#xEA;u t&#x1EE5; &#x111;i&#x1EC7;n Eaton Bussmann</h3>\n <p class=\"v-card__text\">Si&#xEA;u t&#x1EE5; &#x111;i&#x1EC7;n (supercapacitor) d&#x1EA1;ng cell, module: l&#x1B0;u tr&#x1EEF; n&#x103;ng l&#x1B0;&#x1EE3;ng c&#xF4;ng su&#x1EA5;t cao, n&#x1EA1;p x&#x1EA3; nhanh, tu&#x1ED5;i th&#x1ECD; h&#xE0;ng tr&#x103;m ngh&#xEC;n chu k&#x1EF3;.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["phan-phoi-dien-chat-luong-dien-nang"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/phan-phoi-dien/tu-bu-he-so-cong-suat-eaton/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/hl0fqkrh/pd-capacitor-bank.webp?width=600&amp;v=1dd614374d5543e\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">T&#x1EE5; b&#xF9; v&#xE0; b&#x1ED9; &#x111;i&#x1EC1;u khi&#x1EC3;n h&#x1EC7; s&#x1ED1; c&#xF4;ng su&#x1EA5;t Eaton</h3>\n <p class=\"v-card__text\">T&#x1EE5; b&#xF9; trung/h&#x1EA1; th&#x1EBF;, gi&#xE0;n t&#x1EE5; ngo&#xE0;i tr&#x1EDD;i v&#xE0; b&#x1ED9; b&#xF9; t&#x1EF1; &#x111;&#x1ED9;ng MV-AutoVAR &#x2013; n&#xE2;ng h&#x1EC7; s&#x1ED1; c&#xF4;ng su&#x1EA5;t, gi&#x1EA3;m t&#x1ED5;n th&#x1EA5;t v&#xE0; ph&#x1EA1;t c&#xF4;ng su&#x1EA5;t ph&#x1EA3;n kh&#xE1;ng.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["phan-phoi-dien-chat-luong-dien-nang"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/phan-phoi-dien/ups-1-pha-eaton-5e-5p-9sx-9e/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/gjpbp3rp/pd-9sx.webp?width=600&amp;v=1dd614376650521\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">UPS 1 pha Eaton 5E, 5P, 9SX, 9E</h3>\n <p class=\"v-card__text\">C&#xE1;c d&#xF2;ng UPS 1 pha Eaton t&#x1EEB; line-interactive (5E, 5P) &#x111;&#x1EBF;n online chuy&#x1EC3;n &#x111;&#x1ED5;i k&#xE9;p (9SX, 9E) cho m&#xE1;y t&#xED;nh, t&#x1EE7; m&#x1EA1;ng, m&#xE1;y ch&#x1EE7; v&#xE0; thi&#x1EBF;t b&#x1ECB; &#x111;i&#x1EC1;u khi&#x1EC3;n.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["phan-phoi-dien-chat-luong-dien-nang"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/phan-phoi-dien/thanh-phan-phoi-nguon-tu-rack-eaton-epdu/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/bqqnxp2k/pd-managed-pdu.webp?width=600&amp;v=1dd614376f6a9c3\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Power Distribution</span>         <h3 class=\"v-card__title\">Thanh ph&#xE2;n ph&#x1ED1;i ngu&#x1ED3;n cho t&#x1EE7; rack Eaton ePDU</h3>\n <p class=\"v-card__text\">PDU cho t&#x1EE7; rack: Basic, Metered, Managed v&#xE0; Switched &#x2013; &#x111;o, gi&#xE1;m s&#xE1;t v&#xE0; b&#x1EAD;t/t&#x1EAF;t t&#x1EEB;ng &#x1ED5; c&#x1EAF;m t&#x1EEB; xa cho trung t&#xE2;m d&#x1EEF; li&#x1EC7;u v&#xE0; ph&#xF2;ng m&#xE1;y.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["phan-phoi-dien-chat-luong-dien-nang"]}}], "size": 16}