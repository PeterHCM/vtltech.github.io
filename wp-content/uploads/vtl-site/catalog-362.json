{"items": [{"html": "<a class=\"v-card\" href=\"/san-pham/thiet-bi-do/dong-ho-do-ap-baumer/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/x4li1ajp/baumer_barner.png?width=600&amp;v=1dd5fbbcb8e212d\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Baumer</span>         <h3 class=\"v-card__title\">&#x110;&#x1ED3;ng h&#x1ED3; &#x111;o &#xE1;p Baumer</h3>\n <p class=\"v-card__text\">&#x110;&#x1ED3;ng h&#x1ED3; &#x111;o &#xE1;p su&#x1EA5;t, ch&#xEA;nh &#xE1;p Baumer cho d&#x1EA7;u kh&#xED;, h&#xF3;a d&#x1EA7;u, h&#xF3;a ch&#x1EA5;t: v&#x1ECF; inox, c&#xF3; d&#x1EA7;u, nhi&#x1EC1;u d&#x1EA3;i &#x111;o v&#xE0; ki&#x1EC3;u k&#x1EBF;t n&#x1ED1;i, s&#x1EA3;n xu&#x1EA5;t t&#x1EA1;i ch&#xE2;u &#xC2;u.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"hang": ["baumer"], "giaiphap": ["do-luong-luu-luong"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/thiet-bi-do/liquid-controls-do-luu-luong-xang-dau/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/vy1gwts0/liquid_controls_pd_flow-meter_360x250.png?width=600&amp;v=1dd5fbbcaa6113d\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Liquid Controls</span>         <h3 class=\"v-card__title\">Liquid Controls &#x110;o l&#x1B0;u l&#x1B0;&#x1EE3;ng x&#x103;ng d&#x1EA7;u</h3>\n <p class=\"v-card__text\">&#x110;&#x1ED3;ng h&#x1ED3; l&#x1B0;u l&#x1B0;&#x1EE3;ng th&#x1EC3; t&#xED;ch Liquid Controls (M, MA, MS series) cho x&#x103;ng d&#x1EA7;u: ch&#xED;nh x&#xE1;c, b&#x1EC1;n, &#x111;&#x1EBF;n 3.785 L/ph&#xFA;t, d&#xF9;ng cho giao nh&#x1EAD;n th&#x1B0;&#x1A1;ng m&#x1EA1;i.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"hang": ["liquid-controls"], "giaiphap": ["do-luong-luu-luong"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/thiet-bi-do/cam-bien-nhiet-do-baumer/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/hb1jbbx1/baumer_rtd_tcr6_temperaturesensor720wx540h.png?width=600&amp;v=1dd5fbbcb9953e2\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Baumer</span>         <h3 class=\"v-card__title\">C&#x1EA3;m bi&#x1EBF;n nhi&#x1EC7;t &#x111;&#x1ED9; Baumer</h3>\n <p class=\"v-card__text\">C&#x1EA3;m bi&#x1EBF;n nhi&#x1EC7;t &#x111;&#x1ED9; Baumer: Pt100/Pt1000, &#x111;&#x1EA7;u ra 4&#x2013;20 mA ho&#x1EB7;c HART, v&#x1ECF; DIN form B, chi&#x1EC1;u s&#xE2;u nh&#xFA;ng &#x111;&#x1EBF;n 3.000 mm cho d&#x1EA7;u kh&#xED;, h&#xF3;a ch&#x1EA5;t.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"hang": ["baumer"], "giaiphap": ["do-luong-luu-luong"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/thiet-bi-do/thiet-bi-tiep-dia-xe-bon-eaton-egl/\">\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Eaton Crouse-Hinds</span>         <h3 class=\"v-card__title\">Thi&#x1EBF;t b&#x1ECB; ti&#x1EBF;p &#x111;&#x1ECB;a xe b&#x1ED3;n Eaton EGL</h3>\n <p class=\"v-card__text\">Eaton Crouse-Hinds EGL: ki&#x1EC3;m tra v&#xE0; ti&#x1EBF;p &#x111;&#x1ECB;a t&#x129;nh &#x111;i&#x1EC7;n t&#x1EF1; &#x111;&#x1ED9;ng cho xe b&#x1ED3;n khi xu&#x1EA5;t nh&#x1EAD;p nhi&#xEA;n li&#x1EC7;u, r&#x1A1;-le kh&#xF3;a b&#x1A1;m/van, LED xanh/&#x111;&#x1ECF;, v&#x1ECF; IP65 NEMA 4X/7.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"hang": ["crouse-hinds"], "giaiphap": ["do-luong-luu-luong"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/thiet-bi-do/dong-ho-do-nhiet-do-baumer/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/acyjd0nd/vtl_baumer_temperature_gauge_banner.jpg?width=600&amp;v=1dd5fbbcb831ea7\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Baumer</span>         <h3 class=\"v-card__title\">&#x110;&#x1ED3;ng h&#x1ED3; &#x111;o nhi&#x1EC7;t &#x111;&#x1ED9; Baumer</h3>\n <p class=\"v-card__text\">&#x110;&#x1ED3;ng h&#x1ED3; nhi&#x1EC7;t &#x111;&#x1ED9; Baumer nh&#x1EAD;p kh&#x1EA9;u ch&#xE2;u &#xC2;u: d&#x1EA3;i &#x2212;200 &#x2026; 800 &#xB0;C, IP68, nhi&#x1EC1;u ki&#x1EC3;u k&#x1EBF;t n&#x1ED1;i, d&#xF9;ng cho d&#x1EA7;u kh&#xED;, nhi&#x1EC7;t &#x111;i&#x1EC7;n, h&#xF3;a ch&#x1EA5;t, gi&#x1EA5;y, h&#xE0;ng h&#x1EA3;i.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"hang": ["baumer"], "giaiphap": ["do-luong-luu-luong"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/thiet-bi-do/dong-ho-do-turbine-faure-herman/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/1r3inqop/vtl_faure_herma_tzn-6.jpg?width=600&amp;v=1dd5fbbca9832c9\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Faure Herman</span>         <h3 class=\"v-card__title\">&#x110;&#x1ED3;ng h&#x1ED3; &#x111;o Turbine Faure Herman</h3>\n <p class=\"v-card__text\">&#x110;&#x1ED3;ng h&#x1ED3; turbine xo&#x1EAF;n Faure Herman: &#x111;o giao nh&#x1EAD;n th&#x1B0;&#x1A1;ng m&#x1EA1;i ch&#xED;nh x&#xE1;c &#xB1;0,15 %, 50 L/h &#x2013; 5.500 m&#xB3;/h, c&#x1EE1; 1/2&#x2033;&#x2013;18&#x2033;, hi&#x1EC7;u chu&#x1EA9;n theo &#x111;&#x1ED9; nh&#x1EDB;t th&#x1EF1;c t&#x1EBF;.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"hang": ["faure-herman"], "giaiphap": ["do-luong-luu-luong"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/thiet-bi-do/do-luu-luong-sieu-am-faure-herman/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/vwahntog/vtl_faure_herma_fh8400.jpg?width=600&amp;v=1dd5fbbca92263d\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Faure Herman</span>         <h3 class=\"v-card__title\">&#x110;o l&#x1B0;u l&#x1B0;&#x1EE3;ng si&#xEA;u &#xE2;m Faure Herman</h3>\n <p class=\"v-card__text\">&#x110;&#x1ED3;ng h&#x1ED3; si&#xEA;u &#xE2;m Faure Herman FH8400: 3 tia, &#x111;o hai chi&#x1EC1;u, kh&#xF4;ng t&#x1ED5;n th&#x1EA5;t &#xE1;p, hi&#x1EC7;u chu&#x1EA9;n theo Reynolds &#x2013; cho giao nh&#x1EAD;n v&#xE0; &#x111;o qu&#xE1; tr&#xEC;nh d&#x1EA7;u kh&#xED;.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"hang": ["faure-herman"], "giaiphap": ["do-luong-luu-luong"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/thiet-bi-do/dong-ho-do-luu-luong-vortex-thong-minh/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/fdmljd3r/s_svf128_1.jpg?width=600&amp;v=1dd5fbbca61593d\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n        <h3 class=\"v-card__title\">&#x110;&#x1ED3;ng h&#x1ED3; &#x111;o l&#x1B0;u l&#x1B0;&#x1EE3;ng Vortex th&#xF4;ng minh</h3>\n <p class=\"v-card__text\">&#x110;&#x1ED3;ng h&#x1ED3; vortex th&#xF4;ng minh SVF128 &#x111;o l&#x1B0;u l&#x1B0;&#x1EE3;ng h&#x1A1;i, kh&#xED;, ch&#x1EA5;t l&#x1ECF;ng theo nguy&#xEA;n l&#xFD; K&#xE1;rm&#xE1;n, t&#xED;ch h&#x1EE3;p &#xE1;p su&#x1EA5;t &#x2013; nhi&#x1EC7;t &#x111;&#x1ED9;, k&#x1EBF;t n&#x1ED1;i IoT kh&#xF4;ng d&#xE2;y.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"giaiphap": ["do-luong-luu-luong"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/thiet-bi-do/bo-hien-thi-an-toan-noi-tai-eaton-mtl660/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/zqknheyo/mtl660.webp?width=600&amp;v=1dd614344c5f101\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">B&#x1ED9; hi&#x1EC3;n th&#x1ECB; an to&#xE0;n n&#x1ED9;i t&#x1EA1;i c&#x1EA5;p ngu&#x1ED3;n v&#xF2;ng Eaton MTL660</h3>\n <p class=\"v-card__text\">B&#x1ED9; hi&#x1EC3;n th&#x1ECB; s&#x1ED1; l&#x1EA5;y ngu&#x1ED3;n t&#x1EEB; v&#xF2;ng 4&#x2013;20 mA, l&#x1EAF;p &#x111;&#x1B0;&#x1EE3;c trong v&#xF9;ng nguy hi&#x1EC3;m &#x2013; m&#xE0;n h&#xEC;nh l&#x1EDB;n, v&#x1ECF; nh&#xF4;m IP67, c&#xF3; t&#xF9;y ch&#x1ECD;n &#x111;&#xE8;n n&#x1EC1;n.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["an-toan-vung-nguy-hiem", "do-luong-luu-luong"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/thiet-bi-do/may-phan-tich-khi-qua-trinh-eaton-mtl/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/5noprjck/mtl-gir6000.webp?width=600&amp;v=1dd614345f77fc2\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">MTL Instruments</span>         <h3 class=\"v-card__title\">M&#xE1;y ph&#xE2;n t&#xED;ch kh&#xED; qu&#xE1; tr&#xEC;nh Eaton MTL</h3>\n <p class=\"v-card__text\">M&#xE1;y ph&#xE2;n t&#xED;ch kh&#xED; chuy&#xEA;n d&#x1EE5;ng: GIR6000 cho biogas, ph&#xE2;n t&#xED;ch oxy G1010/Z4010, katharometer K1550 cho hydro, KK650 cho s&#x1EA3;n xu&#x1EA5;t clo, K1650 gi&#xE1;m s&#xE1;t kh&#xED; purge m&#xE1;y ph&#xE1;t.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"hang": ["mtl-instruments"], "giaiphap": ["an-toan-vung-nguy-hiem", "do-luong-luu-luong"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/thiet-bi-do/thiet-bi-do-luu-luong-azbil/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/w4ykjlmg/azbil-magnew-mgg.webp?width=600&amp;v=1dd61439f0ad76c\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Azbil</span>         <h3 class=\"v-card__title\">Thi&#x1EBF;t b&#x1ECB; &#x111;o l&#x1B0;u l&#x1B0;&#x1EE3;ng Azbil</h3>\n <p class=\"v-card__text\">L&#x1B0;u l&#x1B0;&#x1EE3;ng k&#x1EBF; &#x111;i&#x1EC7;n t&#x1EEB; MagneW (MGG, MTG 2 d&#xE2;y, MGS v&#x1EC7; sinh, NNK k&#xEA;nh h&#x1EDF;), l&#x1B0;u l&#x1B0;&#x1EE3;ng k&#x1EBF; vortex AX22/AX24, l&#x1B0;u l&#x1B0;&#x1EE3;ng k&#x1EBF; kh&#x1ED1;i nhi&#x1EC7;t MVF/MVC v&#xE0; l&#x1B0;u l&#x1B0;&#x1EE3;ng ch&#xEA;nh &#xE1;p.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"hang": ["azbil"], "giaiphap": ["do-luong-luu-luong"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/thiet-bi-do/thiet-bi-do-muc-nhiet-do-azbil/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/5hhfgwv3/azbil-gtx-level.webp?width=600&amp;v=1dd61439f3f683f\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Azbil</span>         <h3 class=\"v-card__title\">Thi&#x1EBF;t b&#x1ECB; &#x111;o m&#x1EE9;c v&#xE0; nhi&#x1EC7;t &#x111;&#x1ED9; Azbil</h3>\n <p class=\"v-card__text\">&#x110;o m&#x1EE9;c ki&#x1EC3;u ch&#xEA;nh &#xE1;p GTX, ki&#x1EC3;u nh&#xFA;ng JTL, ki&#x1EC3;u phao d&#x1ECB;ch chuy&#x1EC3;n SLX; transmitter nhi&#x1EC7;t &#x111;&#x1ED9; ATT08 v&#xE0; c&#x1EA3;m bi&#x1EBF;n c&#x1EB7;p nhi&#x1EC7;t / RTD YY, YYQS v&#x1EC7; sinh.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"hang": ["azbil"], "giaiphap": ["do-luong-luu-luong"]}}, {"html": "<a class=\"v-card\" href=\"/san-pham/thiet-bi-do/transmitter-ap-suat-azbil-gtx/\">\n        <div class=\"v-card__media v-card__media--contain\"><img src=\"/wp-content/uploads/vtl-site/media/vmrlosrn/azbil-gtx-pressure.webp?width=600&amp;v=1dd61439f6bcd5f\" alt=\"\" loading=\"lazy\"></div>\n    <div class=\"v-card__body\">\n <span class=\"v-card__tag\">Azbil</span>         <h3 class=\"v-card__title\">Transmitter &#xE1;p su&#x1EA5;t Azbil GTX</h3>\n <p class=\"v-card__text\">Transmitter &#xE1;p su&#x1EA5;t d&#xF2;ng GTX: &#xE1;p su&#x1EA5;t t&#x1B0;&#x1A1;ng &#x111;&#x1ED1;i, tuy&#x1EC7;t &#x111;&#x1ED1;i, ch&#xEA;nh &#xE1;p, ki&#x1EC3;u m&#xE0;ng c&#xE1;ch ly t&#x1EEB; xa, ki&#x1EC3;u m&#x1EB7;t b&#xED;ch, ki&#x1EC3;u v&#x1EC7; sinh v&#xE0; &#x111;a bi&#x1EBF;n.</p>         <span class=\"v-card__more\">Xem chi ti&#x1EBF;t →</span>\n    </div>\n</a>", "filters": {"hang": ["azbil"], "giaiphap": ["do-luong-luu-luong"]}}], "size": 13}